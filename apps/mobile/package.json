{
  "name": "@aera/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "description": "The collector. Owns Bluetooth, buffers locally, syncs when the API is reachable.",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform ios",
    "build:release": "eas build --profile production --platform ios"
  },
  "dependencies": {
    "@aera/collector": "*",
    "@aera/protocol": "*",
    "expo": "~57.0.14",
    "expo-dev-client": "~6.0.12",
    "expo-sqlite": "~16.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-ble-plx": "~3.5.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
