{
  "name": "aera",
  "private": true,
  "type": "module",
  "description": "A local-first companion for a fitness band you already own.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "example": "npm run example --workspace @aera/protocol",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
