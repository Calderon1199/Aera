{
  "name": "aera",
  "private": true,
  "type": "module",
  "description": "A local-first companion for a fitness band you already own.",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/cli",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "start": "npm run services && (npm run api & npm run web & wait)",
    "services": "docker compose up -d",
    "api": "cd apps/api && php artisan serve --host=127.0.0.1 --port=8000",
    "web": "npm run dev --workspace @aera/web",
    "example": "npm run example --workspace @aera/protocol",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  }
}
